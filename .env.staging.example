# =============================================================================
# SanitiGo Cloud Staging Environment Configuration Template (.env.staging.example)
# Phase 10.2: Cloud Staging Deployment
# =============================================================================

# 1. Staging Environment & Networking
NODE_ENV=staging
PORT=5000
CORS_ORIGIN=https://staging.sanitigo.com,https://sanitigo-staging.vercel.app,http://localhost:3000,http://localhost:8080
COOKIE_SAMESITE=none

# 2. Managed PostgreSQL Database (Neon Serverless PostgreSQL - Staging Branch)
# Neon Staging Branch: br-lucky-band-b3047371 (Region: aws-ap-southeast-1)
# Note: DATABASE_URL uses Neon connection pooler for high concurrency.
# DATABASE_URL_UNPOOLED uses direct compute endpoint for Prisma migrations.
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-gentle-queen-b3sr1xis-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-gentle-queen-b3sr1xis.c-4.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# 3. Authentication & Cryptographic Secrets (Generated via crypto.randomBytes(32).toString('hex'))
JWT_ACCESS_SECRET=your_generated_64_character_hex_access_secret_for_staging
JWT_REFRESH_SECRET=your_generated_64_character_hex_refresh_secret_for_staging
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 4. Message Broker (Managed CloudAMQP or Staging RabbitMQ Cluster)
# Example CloudAMQP AMQPS URI: amqps://USER:PASSWORD@server.rmq.cloudamqp.com/VHOST
RABBITMQ_URL=amqps://sanitigo_staging:YOUR_RMQ_PASSWORD@server.rmq.cloudamqp.com/sanitigo_vhost
RABBITMQ_EXCHANGE=sanitigo.events
RABBITMQ_HOST=server.rmq.cloudamqp.com
RABBITMQ_PORT=5671
RABBITMQ_USERNAME=sanitigo_staging
RABBITMQ_PASSWORD=YOUR_RMQ_PASSWORD

# 5. Java Notification Service (Spring Boot JDBC & Profiles)
SPRING_PROFILES_ACTIVE=staging
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-gentle-queen-b3sr1xis.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=YOUR_NEON_PASSWORD

# 6. Payment Gateway Configuration (Razorpay Sandbox/Test Mode - 'mock' is STRICTLY prohibited)
PAYMENT_MODE=razorpay
RAZORPAY_KEY_ID=rzp_test_your_staging_key_id
RAZORPAY_KEY_SECRET=your_razorpay_staging_secret
PAYMENT_WEBHOOK_SECRET=whsec_staging_hmac_secret_minimum_32_characters

# 7. Cloudinary Media Storage (Staging Assets)
CLOUDINARY_CLOUD_NAME=your_staging_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_staging_cloudinary_api_key
CLOUDINARY_API_SECRET=your_staging_cloudinary_api_secret

# 8. Frontend Public Routing
VITE_API_BASE_URL=https://api-staging.sanitigo.com/api/v1
VITE_APP_NAME=SanitiGo (Staging)
VITE_ENABLE_MOCK_PAYMENT=false

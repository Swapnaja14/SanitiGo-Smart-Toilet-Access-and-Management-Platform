# =============================================================================
# SanitiGo Cloud Production Environment Configuration Template (.env.production.example)
# Phase 10.3: Live Production Deployment
# =============================================================================

# 1. Production Environment & Networking
NODE_ENV=production
PORT=5000
CORS_ORIGIN=https://sanitigo.com,https://sanitigo-frontend-prod.onrender.com
COOKIE_SAMESITE=none

# 2. Managed PostgreSQL Database (Neon Serverless PostgreSQL - Production Branch)
# Neon Production Branch: br-withered-breeze-b3uorfzt (Region: aws-ap-southeast-1)
# Note: DATABASE_URL uses Neon connection pooler for high concurrency.
# DATABASE_URL_UNPOOLED uses direct compute endpoint for schema inspection.
DATABASE_URL=postgresql://neondb_owner:YOUR_PROD_NEON_PASSWORD@ep-steep-shadow-b3jp78tc-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:YOUR_PROD_NEON_PASSWORD@ep-steep-shadow-b3jp78tc.c-4.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# 3. Authentication & Cryptographic Secrets (Generated via crypto.randomBytes(32).toString('hex'))
JWT_ACCESS_SECRET=your_isolated_production_64_character_hex_access_secret
JWT_REFRESH_SECRET=your_isolated_production_64_character_hex_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 4. Message Broker (Managed CloudAMQP Production Cluster over AMQPS/TLS)
RABBITMQ_URL=amqps://sanitigo_prod:YOUR_PROD_RMQ_PASSWORD@server.rmq.cloudamqp.com/sanitigo_prod_vhost
RABBITMQ_EXCHANGE=sanitigo.events
RABBITMQ_HOST=server.rmq.cloudamqp.com
RABBITMQ_PORT=5671
RABBITMQ_USERNAME=sanitigo_prod
RABBITMQ_PASSWORD=YOUR_PROD_RMQ_PASSWORD

# 5. Java Notification Service (Spring Boot JDBC & Profiles)
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://ep-steep-shadow-b3jp78tc.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=YOUR_PROD_NEON_PASSWORD
RABBITMQ_SSL_ENABLED=true

# 6. Payment Gateway Configuration (Razorpay Live Production Mode)
# STRICT SAFETY: PAYMENT_MODE must be 'razorpay'. 'mock' is forbidden in production.
PAYMENT_MODE=razorpay
RAZORPAY_KEY_ID=rzp_live_your_actual_production_key_id
RAZORPAY_KEY_SECRET=your_actual_production_razorpay_secret
PAYMENT_WEBHOOK_SECRET=whsec_prod_live_hmac_secret_minimum_32_characters

# 7. Cloudinary Media Storage (Production Assets)
CLOUDINARY_CLOUD_NAME=your_prod_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_prod_cloudinary_api_key
CLOUDINARY_API_SECRET=your_prod_cloudinary_api_secret

# 8. Operational Monitoring & Emergency Webhook Alerts
OPERATIONAL_ALERT_WEBHOOK_URL=https://webhook.site/your-production-incident-alert-webhook

# 9. Frontend Public Routing
VITE_API_BASE_URL=https://sanitigo-backend-prod.onrender.com/api/v1
VITE_APP_NAME=SanitiGo
VITE_ENABLE_MOCK_PAYMENT=false

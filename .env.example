# =============================================================================
# SanitiGo Environment Template (.env.example)
# Copy this file to .env and provide your production runtime secrets.
# DO NOT commit real secrets or credentials into version control.
# =============================================================================

# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=sanitigo
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public
DATABASE_URL_UNPOOLED=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# Application Environment
NODE_ENV=production
PORT=5000

# Authentication & Cryptographic Secrets (must be >= 32 characters)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_random_hex
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_random_hex

# Messaging Broker (RabbitMQ)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=sanitigo_app
RABBITMQ_PASSWORD=your_secure_rabbitmq_password
RABBITMQ_URL=amqp://${RABBITMQ_USERNAME}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}
RABBITMQ_EXCHANGE=sanitigo.events

# Payment Gateway Configuration
# NOTE: PAYMENT_MODE must be 'razorpay' in production. 'mock' is strictly prohibited.
PAYMENT_MODE=razorpay
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_for_hmac_verification
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Frontend Build & Routing
# In container deployment, use same-origin relative path '/api/v1' (proxied via Nginx)
# In decoupled static hosting (e.g. Vercel), set to 'https://api.yourdomain.com/api/v1'
VITE_API_BASE_URL=/api/v1

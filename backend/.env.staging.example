# Backend Staging Configuration
PORT=5000
NODE_ENV=staging
CORS_ORIGIN=https://staging.sanitigo.com,https://sanitigo-staging.vercel.app,http://localhost:3000,http://localhost:8080
COOKIE_SAMESITE=none

# Neon Serverless PostgreSQL Staging Branch (Region: aws-ap-southeast-1)
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-gentle-queen-b3sr1xis-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-gentle-queen-b3sr1xis.c-4.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Cryptographic Secrets
JWT_ACCESS_SECRET=your_generated_64_character_hex_access_secret_for_staging
JWT_REFRESH_SECRET=your_generated_64_character_hex_refresh_secret_for_staging
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# RabbitMQ / CloudAMQP Staging Broker
RABBITMQ_URL=amqps://sanitigo_staging:YOUR_RMQ_PASSWORD@server.rmq.cloudamqp.com/sanitigo_vhost
RABBITMQ_EXCHANGE=sanitigo.events

# Payment Gateway (Razorpay Sandbox)
PAYMENT_MODE=razorpay
PAYMENT_WEBHOOK_SECRET=whsec_staging_hmac_secret_minimum_32_characters
RAZORPAY_KEY_ID=rzp_test_your_staging_key_id
RAZORPAY_KEY_SECRET=your_razorpay_staging_secret

# Cloudinary Staging
CLOUDINARY_CLOUD_NAME=your_staging_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_staging_cloudinary_api_key
CLOUDINARY_API_SECRET=your_staging_cloudinary_api_secret

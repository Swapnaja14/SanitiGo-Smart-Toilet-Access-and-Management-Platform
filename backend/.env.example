# .env exact format

PORT=5000
NODE_ENV=development

DATABASE_URL=
TEST_DATABASE_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# RabbitMQ Application Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=sanitigo_app
RABBITMQ_PASSWORD=
RABBITMQ_URL=amqp://sanitigo_app:YOUR_PASSWORD_HERE@localhost:5672
RABBITMQ_EXCHANGE=sanitigo.events

# Payment Provider Configuration
PAYMENT_MODE=mock
PAYMENT_WEBHOOK_SECRET=your_provider_webhook_secret_here
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here